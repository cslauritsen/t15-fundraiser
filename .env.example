# Copy to .env; the server loads it at startup (no need to `source` it). Never commit .env.
# Variables already set in your shell override this file.
BASE_URL=http://127.0.0.1:3000          # public https URL in production
BIND_ADDR=127.0.0.1:8080
DATABASE_PATH=./data/fundraiser.db
CATALOG_PATH=./catalog.yaml
STATIC_DIR=./static                      # contains images/
FRONTEND_DIR=./frontend/dist             # trunk build output
STRIPE_SECRET_KEY=sk_test_...            # test key while developing
STRIPE_WEBHOOK_SECRET=whsec_...          # from `stripe listen` (dev) or the dashboard endpoint (prod)
# TRUST_PROXY=1                          # only behind a reverse proxy that sets X-Forwarded-For
# ALLOW_MISSING_IMAGES=1                 # dev only: skip the startup image-file check
